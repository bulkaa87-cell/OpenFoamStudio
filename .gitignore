# Allow list: this repository holds only the program and the community files.
# Git ignores all files, except the files that are named below.
# The community files are README, CONTRIBUTING, SECURITY, CODE_OF_CONDUCT
# and the GitHub templates in .github/.
# Do not add other documents, notes, settings, cases, models or tests.

/*

!/.gitignore
!/LICENSE

# Community files
!/README.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
!/.github/
/.github/*
!/.github/pull_request_template.md
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml
!/.github/ISSUE_TEMPLATE/config.yml

# Program (Python)
!/foam_studio.py
!/fs_*.py
!/requirements.txt
!/OpenFOAM Studio.bat

# Translations of the interface (the program reads them at run time)
!/i18n/
/i18n/*
!/i18n/en/

# Rust modules: only the source and the build files
!/rust/
/rust/*/*
!/rust/*/src/
!/rust/*/Cargo.toml
!/rust/*/Cargo.lock
!/rust/*/.cargo/

# Build script for the Rust modules
!/tools/
/tools/*
!/tools/build_rust.ps1

# Always ignore build output, caches and local settings
target/
__pycache__/
*.pyc
*.pyd
*.pyd.old-*
.venv/
session.json
session/
.telegram.json
